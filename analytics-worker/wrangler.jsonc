{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "priyanka-visitor-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "priyanka-visitor-analytics",
    "database_id": "bcdb3077-4022-4b69-a2b3-8f5e9b4c3249"
  }],
  "vars": {
    "ALLOWED_ORIGINS": "https://priyankagawade08.github.io"
  },
